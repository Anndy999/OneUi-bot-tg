# Copy to /etc/oneui-bot/oneui-download.env on the VPS.
# Never commit the real file or send its values in chat.
NODE_ENV=production
APP_VERSION=2.22.1
DOWNLOAD_HOST=127.0.0.1
DOWNLOAD_PORT=8788
DOWNLOAD_DIR=/opt/oneui-bot/data/firmware
# Keep the internal task index outside public file-list directories.
DOWNLOAD_INDEX_DIR=/opt/oneui-bot/data/download-state
DOWNLOAD_API_SECRET=REPLACE_WITH_A_RANDOM_SECRET
# Keep only official Samsung/FUS hosts. Add a host only after verification.
DOWNLOAD_ALLOWED_HOSTS=samsung.com,samsungmobile.com,ospserver.net,cdngc.net
DOWNLOAD_MAX_BYTES=21474836480
DOWNLOAD_MIN_FREE_BYTES=42949672960
# Log one administrator-visible journal warning per hour when the reserve is breached.
# New downloads are already blocked below the reserve; this never deletes files.
DOWNLOAD_CAPACITY_WARNING_INTERVAL_MS=3600000
DOWNLOAD_COMPLETED_TTL_MS=604800000
DOWNLOAD_PART_TTL_MS=21600000
# Maximum wait for Samsung response headers. An active download is not cut off.
DOWNLOAD_RESPONSE_HEADER_TIMEOUT_MS=60000
# Fail and retry a connection that stops delivering body data after headers.
DOWNLOAD_BODY_IDLE_TIMEOUT_MS=120000
# Mark an active task unhealthy if no progress heartbeat is persisted.
DOWNLOAD_JOB_STALE_MS=300000
# Bound local download API request handling.
DOWNLOAD_API_REQUEST_TIMEOUT_MS=30000
DOWNLOAD_PARALLEL_SEGMENTS=8
# Stable-120 profile: start and stay at eight bounded download lanes.
# Connection setup remains staggered so eight lanes do not create a burst.
DOWNLOAD_PARALLEL_MAX_SEGMENTS=8
DOWNLOAD_PARALLEL_TARGET_BYTES_PER_SECOND=125829120
DOWNLOAD_PARALLEL_SCALE_INTERVAL_MS=8000
DOWNLOAD_PARALLEL_SCALE_STEP=2
# Keep both lane values at 8 for the intended stable-120 profile. Twelve is an
# explicit experiment only; do not use the old 16/24 burst profile.
# Stagger parallel connection setup to avoid Samsung source throttling.
DOWNLOAD_PARALLEL_STAGGER_MS=100
# One GiB long-lived ranges avoid repeated late-stage Samsung FUS Range
# authorization/throttling. A 17 GiB file still has more ranges than the eight
# lanes, so pause/resume and work stealing remain available.
DOWNLOAD_PARALLEL_CHUNK_BYTES=1073741824
# Commit 4 MiB at a time to reduce filesystem overhead without ever marking
# bytes complete before their positional write succeeds. Valid range: 64 KiB-16 MiB.
DOWNLOAD_PARALLEL_WRITE_BATCH_BYTES=4194304
# Files smaller than this use one connection; failed range probes fall back automatically.
DOWNLOAD_PARALLEL_MIN_BYTES=67108864
# Retry a failed individual Range before falling back to one connection.
DOWNLOAD_PARALLEL_RETRIES=3
# Bifrost-style native AES-ECB stream: no worker-message copying or random
# writes. This is the recommended VPS profile and uses 16 MiB sequential I/O.
DOWNLOAD_DECRYPT_MODE=stream
DOWNLOAD_DECRYPT_STREAM_CHUNK_BYTES=16777216
# A paused Range-capable download resumes its saved byte ranges after restart.
# Do not manually delete *.part files; use the Telegram Delete button instead.
DOWNLOAD_QUEUE_PREFIX=oneui-download
REDIS_URL=redis://:REPLACE_WITH_REDIS_PASSWORD@127.0.0.1:56379/0
