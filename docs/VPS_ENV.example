# VPS-only configuration template. Copy these keys into the VPS secret store.
NODE_ENV=production
VPS_HOST=127.0.0.1
VPS_PORT=8787
VPS_PUBLIC_BASE_URL=
TELEGRAM_POLLING_ENABLED=false
TELEGRAM_POLLING_TIMEOUT_SECONDS=30
VPS_SHADOW_MODE=true
TELEGRAM_SEND_ENABLED=false
MONITOR_NOTIFICATIONS_ENABLED=false
VPS_SCHEDULE_INTERVAL_MS=60000

# Required in production, injected outside Git.
WEBHOOK_SECRET=example-webhook-secret
INTERNAL_API_SECRET=replace-with-a-separate-long-random-value
TELEGRAM_BOT_TOKEN=example-telegram-token
TELEGRAM_CHAT_ID=12345

# Runtime services.
DATABASE_URL=postgresql://oneui:change-me@postgres:5432/oneui
REDIS_URL=redis://redis:6379
QUEUE_PREFIX=oneui

# Existing application settings can be copied from wrangler.toml vars.
DEFAULT_CSC=CHC
DEFAULT_TIMEZONE=Asia/Shanghai
DEFAULT_MONITOR_START_TIME=00:00
DEFAULT_MONITOR_END_TIME=23:59
DEFAULT_SKIP_WEEKENDS=false
MONITOR_SCHEDULER_ENABLED=true
NOTIFICATION_QUEUE_ENABLED=true
QUERY_COORDINATOR_ENABLED=true
TELEGRAM_COMMAND_SYNC_ENABLED=false
TELEGRAM_WEBHOOK_AUTOFIX_ENABLED=false
